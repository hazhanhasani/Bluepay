# BluePay 1.2.3 production variables for Railway

# Existing secrets — keep the current real values in Railway.
BOT_TOKEN=
GITHUB_TOKEN=

# PostgreSQL service must be named exactly: Postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_REQUIRE_POSTGRES=true
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_SECONDS=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

# Public application settings. Railway supplies PORT automatically.
BASE_URL=https://bluepay-production.up.railway.app
APP_ENV=production
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
PORTAL_SECRET=

# Business and worker settings.
INVOICE_TTL_MINUTES=30
DEFAULT_FEE_RIAL=20000
CALLBACK_WORKER_INTERVAL_SECONDS=2
CALLBACK_WORKER_BATCH_SIZE=30
SMS_HMAC_MAX_AGE_SECONDS=300
RELEASE_STAGING_BRANCH=bluepay-staging
STARTUP_FAIL_OPEN=false

# Explicitly disable the legacy encrypted SQLite snapshot once PostgreSQL is active.
GATEWAY_DISABLE_REMOTE_BACKUP=1
GATEWAY_RUNTIME_DIR=/app/runtime
GITHUB_REPOSITORY=hazhanhasani/Bluepay

# Optional. Leave empty unless Sentry is configured.
SENTRY_DSN=
