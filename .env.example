# Required
BOT_TOKEN=

# Required for publishing ZIP updates. Also used for encrypted SQLite backup compatibility.
GITHUB_TOKEN=

# Recommended for production: Railway PostgreSQL URL.
# If omitted, the project keeps using SQLite for backward compatibility.
DATABASE_URL=

# Railway normally provides PORT and RAILWAY_PUBLIC_DOMAIN automatically.
BASE_URL=
PORT=8080

# Optional operational settings
PORTAL_SECRET=
SENTRY_DSN=
APP_ENV=production
CALLBACK_WORKER_INTERVAL_SECONDS=2
CALLBACK_WORKER_BATCH_SIZE=30

# auto = webhook on HTTPS, polling on localhost; webhook/polling force a mode.
TELEGRAM_MODE=auto
TELEGRAM_WEBHOOK_SECRET=

# Secure SMS Forwarder replay window in seconds.
SMS_HMAC_MAX_AGE_SECONDS=300

# ZIP staging branch used before production publishing.
RELEASE_STAGING_BRANCH=bluepay-staging

# Keep false in production. A failed schema guard must not start business traffic.
STARTUP_FAIL_OPEN=false
