# Required
BOT_TOKEN=

# Used for ZIP publishing and encrypted SQLite backup compatibility.
GITHUB_TOKEN=

# Recommended for production: Railway PostgreSQL URL.
# If omitted, the project keeps using SQLite for backward compatibility.
DATABASE_URL=

# Optional. Railway normally provides PORT and RAILWAY_PUBLIC_DOMAIN.
BASE_URL=
PORT=8080
PORTAL_SECRET=
SENTRY_DSN=
APP_ENV=production
CALLBACK_WORKER_INTERVAL_SECONDS=2
CALLBACK_WORKER_BATCH_SIZE=30
